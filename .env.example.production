APP_ENV=production
APP_KEY=base64:GENERATE_NEW_APP_KEY_ON_YOUR_SERVER
APP_DEBUG=false
APP_URL=https://domain-kamu.com
APP_NAME="ZAPPAY"
APP_IMAGE=/assets/logo/logo.png
LOGO_FAVICON=/assets/logo/favicon.png
COIN_STORE=IDR

# Security hardening ZAPPAY
ADMIN_IP_WHITELIST_ENABLED=false
MINIMUM_PRODUCT_PROFIT=100
MAX_COIN_USAGE_PERCENT=10
TOPUPEDIA_API_KEY=
DIGIFLAZZ_SELLER_ALLOWED_IPS=52.74.250.133
VIP_CALLBACK_ALLOWED_IPS=178.248.73.218
APIGAMES_CALLBACK_ALLOWED_IPS=157.245.207.5,54.86.50.139
PAYDISINI_CALLBACK_ALLOWED_IPS=195.88.211.145

# Cloudflare Turnstile / Captcha
TURNSTILE_SECRET_KEY=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nama_database_kamu
DB_USERNAME=user_database_kamu
DB_PASSWORD=password_database_kamu

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# API internal / eksternal
API_REQUIRE_BEARER=true
LABURAGAME_API_KEY=
IPINFO_TOKEN=
DIGIFLAZZ_CALLBACK_SECRET=
PAYDISINI_MERCHANT_ID=
PEMBELIAN_STATUS_WEBHOOK_URL=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

MEMCACHED_HOST=127.0.0.1
